### Example 3-2 Modified to show calculations using simple python arrays side-by-side with torch library calls

# Manually Initialize Model Parameters
with torch.no_grad():
    model.output.weight[0,0] = 1.0
    model.output.weight[1,0] = 0.0
    model.output.weight[2,0] = -1.0
    model.output.bias[0] = 0
    model.output.bias[1] = 0
    model.output.bias[2] = 0

# Duplicating the neural net without the torch library
# Initialize
W1 = [1, 0, -1]
B1 = [0, 0, 0]

for i in range(num_steps):
    optimizer.zero_grad()
    outputs = model(torch.tensor(X[i%len(y)]).float())
    loss = criterion(outputs, torch.tensor(y[i%len(y)]))
   
    loss.backward()
    optimizer.step()

    ######################################################
    # Same calculations using arrays
    # Forward through the model
    H1 = X[i%len(y)] * W1 + B1
    # Softmax function
    Yhat = np.exp(H1)/np.exp(H1).sum()
    
    # Calculate Cross Entropy Loss
    ce_loss = -np.log(Yhat)[y[i%len(y)]]

    y_ideal = np.zeros(len(H1))
    y_ideal[y[i%len(y)]] = 1
    
    dLdh = Yhat - y_ideal
    dLdm = X[i%len(y)] * dLdh
    dLdb = dLdh
    
    # Update weights
    W1 = W1 - 0.05 * dLdm
    B1 = B1 - 0.05 * dLdb
    #######################################################

    
    if (i+1) % 10 == 0:
        with torch.no_grad():
            logits = model(torch.tensor(X, dtype = torch.float))
            accuracy = (torch.argmax(logits, dim=1) == torch.tensor(y)).sum().item()/len(y)
        print(f"Torch:  Step {i+1}/{num_steps}, Loss: {loss.item():.4f}, Accuracy: {accuracy:.4f}")

        ### Accuracy using arrays
        py_logits = X * W1 + B1
        py_accuracy = (torch.argmax(torch.tensor(py_logits), dim=1) == torch.tensor(y)).sum().item()/len(y)
        print(f"Python: Step {i+1}/{num_steps}, Loss: {ce_loss:.4f}, Accuracy: {py_accuracy:.4f}")
        print("-----------------------------------------")


